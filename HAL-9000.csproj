<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>HAL9000</RootNamespace>
    <AssemblyName>HAL9000</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <KSPBT_ModRoot>$(MSBuildProjectDirectory)/GameData/HAL-9000</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
    <KSPBT_InstallCKANDependencies>false</KSPBT_InstallCKANDependencies>
  </PropertyGroup>
  <ItemGroup>
    <KSPVersionFile Include="$(MSBuildProjectDirectory)/GameData/HAL-9000/HAL-9000.version">
      <Destination>$(MSBuildProjectDirectory)/GameData/HAL-9000/HAL-9000.version</Destination>
      <KSP_Version_Min>1.12.3</KSP_Version_Min>
    </KSPVersionFile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>
</Project>
